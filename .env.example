# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# API key de Resend, usada por src/lib/send-contact-email.ts para
# enviar el email del formulario de contacto. Sin esta variable el
# formulario sigue funcionando (valida igual) pero no envía el email
# y muestra un mensaje pidiendo escribir directamente.
# Crear cuenta y key en: https://resend.com/api-keys
RESEND_API_KEY=
